# DevFlow Environment Variables Template

# Backend Settings
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# PostgreSQL Connection String
DATABASE_URL=postgresql://devflow_user:replace_with_password@localhost:5432/devflow_db?schema=public

# Optional Docker Compose PostgreSQL
POSTGRES_USER=devflow_user
POSTGRES_PASSWORD=replace_with_password
POSTGRES_DB=devflow_db
POSTGRES_PORT=5434
