# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Authentication Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# PostgreSQL Connection String (PostgreSQL 18 default port is 5432)
DATABASE_URL=postgresql://devflow_user:replace_with_password@localhost:5432/devflow_db?schema=public
